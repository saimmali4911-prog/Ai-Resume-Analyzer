# Flask Application Configuration
SECRET_KEY=generate-a-strong-random-key-in-production
DEBUG=1
MAX_UPLOAD_MB=5
PORT=5000

# Set USE_SQLITE=1 for zero-config local development, or 0 for MySQL
USE_SQLITE=1

# Google Gemini API Key (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=

# MySQL Configuration (used when USE_SQLITE=0)
DB_NAME=resume_analyzer
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
